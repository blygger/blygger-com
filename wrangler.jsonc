{
  // blygger.com — the blyg directory.
  //
  // account_id is Venkat's PERSONAL account — the same one blygger.org's Pages
  // project lives in, and deliberately NOT the Protocol Institute org account
  // (blygger.com is the commercial-adjacent sibling; see blygger-spec decision
  // records and Code/warnings-keys.md). It is an identifier, not a credential.
  "name": "blygger-com",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "account_id": "7026b5d7c1ad16cb808987576bb07ab2",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blygger-com",
      "database_id": "ea8417e7-7547-47c0-82f7-9f298d545915",
      "migrations_dir": "migrations"
    }
  ],
  // Once DNS is onboarded, a Custom Domain (not a Route) — it auto-provisions
  // the DNS record, and this worker owns the whole origin so there is no path
  // space to share. Same reasoning as self-host-plan.md §2.2.
  "routes": [
    { "pattern": "blygger.com", "custom_domain": true }
  ]
}
